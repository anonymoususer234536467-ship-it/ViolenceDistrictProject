local Table1 = {
	"ImageLabel";
	"Gameplay";
}

--// Create tab FUNC
local function CreateTab(txt)
	local newTab = ReplicatedStorage.Spectator.Spectatot.Settings.ScrollingFrame.Gameplay:Clone()
	newTab.Parent = SettingsUI.ScrollingFrame
	newTab.Name = txt

	local Text = newTab.Gameplay
	Text.Text = txt

	for _, child in pairs(newTab:GetChildren()) do
		if not table.find(Table1, child.Name) then
			child:Destroy()
		end
	end

	local buttonHolder = Instance.new("Frame")
	buttonHolder.Name = "ButtonHolder"
	buttonHolder.BackgroundTransparency = 1
	buttonHolder.Size = UDim2.new(0.7, 0, 0, 200)
	buttonHolder.Position = UDim2.new(0, 0, 0.2, 0)
	buttonHolder.Parent = newTab

	local layout = Instance.new("UIListLayout")
	layout.Parent = buttonHolder
	layout.HorizontalAlignment = "Right"
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 30)

	return newTab
end

--// Create button FUNC
local function CreateButton(txt, desc, Tab)
	local newButton = ReplicatedStorage.Spectator.Spectatot.Settings.ScrollingFrame.Gameplay.chance:Clone()
	newButton.Name = txt
	newButton.Size = UDim2.new(0, 575, 0, 60)
	newButton.Text = txt
	newButton["Epilepsy mode"].Text = desc
	newButton.Parent = Tab.ButtonHolder

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 25)
	padding.Parent = newButton

	local script = newButton.ImageButton:FindFirstChildWhichIsA("LocalScript")
	if script then
		script:Destroy()
	end

	return newButton
end

